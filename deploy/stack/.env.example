# Names only, for humans: no tool reads this file. Values are placed on the host by the owner's
# provisioning, never committed.
LEDGEFALL_IMAGE=            # written by the deploy (name:tag of the image built from ../../Dockerfile)
NPK_CONTROL_SECRET=         # 16+ random characters: the lobby and the game server share it
NPK_PUBLIC_UDP=             # ledgefall.<tailnet>.ts.net:7777: what the lobby tells players to connect to
TS_AUTHKEY=                 # the sidecar's one-time key (first start only)
